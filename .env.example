NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Resend (outbound email). Create a key at https://resend.com/api-keys and paste
# it below: the re_xxxxxxxxx placeholder is rejected until you replace it, and the
# key is server-only, so it never gets a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_xxxxxxxxx

# The verified sender address. onboarding@resend.dev is Resend's shared test
# address and only delivers to the Resend account owner, so replace it with your
# own domain once it is verified.
RESEND_FROM_EMAIL=onboarding@resend.dev